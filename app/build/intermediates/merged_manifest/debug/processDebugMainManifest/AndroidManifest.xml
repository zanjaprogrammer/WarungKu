<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.zanjaprogrammer.warungku"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

    <permission
        android:name="com.zanjaprogrammer.warungku.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.zanjaprogrammer.warungku.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@android:drawable/star_on"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/star_on"
        android:supportsRtl="true"
        android:theme="@style/Theme.WarungKu" >
        <activity
            android:name="com.zanjaprogrammer.warungku.MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.zanjaprogrammer.warungku.SellActivity" />
        <activity android:name="com.zanjaprogrammer.warungku.StockActivity" />
        <activity android:name="com.zanjaprogrammer.warungku.AddProductActivity" />
        <activity android:name="com.zanjaprogrammer.warungku.HistoryActivity" />
        <activity android:name="com.zanjaprogrammer.warungku.ShoppingListActivity" />
        <activity
            android:name="com.zanjaprogrammer.warungku.SummaryActivity"
            android:exported="true" />

        <service
            android:name="androidx.room.MultiInstanceInvalidationService"
            android:directBootAware="true"
            android:exported="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.zanjaprogrammer.warungku.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>

</manifest>